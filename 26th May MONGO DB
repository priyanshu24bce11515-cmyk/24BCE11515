--operator in MongoDB
1.EQUAL OPERATOR
---------------------------------------------------------------
db.products.find({
    color: {
        $eq: "black"
    }
}, {
    name: 1,
    color: 1
})
--this searches if the colour is equal black its kind of OR operator thing

------------------------------------------------------------------------------
db.products.find({
    price: {
        $eq: 899
    }
}, {
    name: 1,
    price: 1
})
-- this searches if price is equals to 899

----------------------------------------------------------------------------
db.products.find({
    "spec.ram": 4

}, {
    name: 1,
    "spec.ram": 1
})
=============================================================================

2.LESS THAN (LT) OR LESS THAN EQUAL(LTE) {applicable only for numeriical field
---------------------------------------------------------------------------
db.products.find({
    price: {
        $lt: 799
    }
}, {
    name: 1,
    price: 1
})
--This is print name,id,proce of elements having price less tham 799
------------------------------------------------------------------------

db.products.find({
    "spec.screen": {
        $lt: 7
    }
}, {
    name: 1,
    "spec.screen": 1
})
--this will do same but for spec.screen
----------------------------------------------------------------
db.products.find({
    storage: {
        $lte: 128
    }
}, {
    name: 1,
    storage: 1
})
-- this will select the value wjich is lessthan and equal to 128
=================================================================

3.GREATEER OR GREATER THAN EQUALS
------------------------------------------------------------
db.products.find({
    storage: {
        $gt: 128
    }
}, {
    name: 1,
    storage: 1
})
-- This will print the storage greater than 128
----------------------------------------------------------------
db.products.find({
    "spec.screen": {
        $gte: 7
    }
}, {
    name: 1,
    "spec.screen": 1
})
--this prints the spec.screen which has value greater than 7
------------------------------------------------------------------
db.products.find({"price":{$gte:799}},{name:1,price:1})
